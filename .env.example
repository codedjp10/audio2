# Copie este arquivo para ".env" e ajuste os valores.

# Chave secreta usada pelo Flask para sessões/cookies. Gere uma aleatória em produção.
SECRET_KEY=troque-esta-chave-por-uma-aleatoria-e-secreta

# URL de conexão do banco de dados.
# Desenvolvimento (SQLite):
DATABASE_URL=sqlite:///igreja.db

# Produção (exemplo PostgreSQL) — basta trocar a linha acima por algo como:
# DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# Ambiente: development | production
FLASK_ENV=development

# Pasta de uploads de fotos (relativa a app/static)
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=5
